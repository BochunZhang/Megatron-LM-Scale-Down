{
  "permissions": {
    "Bash": {
      "allow": [
        "Bash(git fetch:*)",
        "Bash(git checkout:*)",
        "WebFetch(domain:github.com)",
        "WebSearch",
        "Bash(*)",
        "Grep(*)",
        "Glob(*)",
        "Read(*)",
        "Edit(*)",
        "Write(*)",
        "git status",
        "git log",
        "git diff",
        "git show",
        "git branch",
        "git remote",
        "ls *",
        "cat *",
        "find *",
        "grep *",
        "head *",
        "tail *",
        "python *",
        "pytest *",
        "torchrun *",
        "python -m *",
        "mkdir *",
        "cp *",
        "mv *",
        "rm *"
      ]
    },
    "Edit": {
      "allow": [{"pattern": "*.py"}, {"pattern": "*.json"}, {"pattern": "*.yaml"}, {"pattern": "*.yml"}, {"pattern": "*.md"}, {"pattern": "*.toml"}, {"pattern": "*.txt"}, {"pattern": "*.sh"}, {"pattern": "*.cu"}, {"pattern": "*.cpp"}, {"pattern": "*.h"}, {"pattern": "*.cuh"}]
    },
    "Write": {
      "allow": [{"pattern": "*.py"}, {"pattern": "*.json"}, {"pattern": "*.yaml"}, {"pattern": "*.yml"}, {"pattern": "*.md"}, {"pattern": "*.toml"}, {"pattern": "*.txt"}, {"pattern": "*.sh"}, {"pattern": "*.cu"}, {"pattern": "*.cpp"}, {"pattern": "*.h"}, {"pattern": "*.cuh"}]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"MANDATORY WORKFLOW — never skip or reorder: (1) Read the artifact first (commit, file, error, PR). (2) Identify and invoke the relevant skill via the Skill tool BEFORE forming any answer or plan — even when the answer seems obvious. (3) Only then answer using the skill context. Skipping step 2 is not allowed.\"}}'"
          }
        ]
      }
    ]
  }
}
